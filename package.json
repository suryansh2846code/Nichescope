{
  "name": "nichescope",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "scrape:profile": "bun run src/scraper/instagram.ts",
    "worker:scrape": "bun run src/workers/scrapeWorker.ts",
    "worker": "bun run src/workers/scrapeWorker.ts",
    "worker:discover": "bun run src/workers/hashtagDiscoveryWorker.ts",
    "worker:analyze": "bun run src/workers/aiAnalysisWorker.ts",
    "worker:user": "bun run src/workers/userIntelligenceWorker.ts",
    "worker:embedding": "bun run src/workers/embeddingWorker.ts",
    "worker:monitoring": "bun run src/workers/monitoringWorker.ts",
    "worker:qualification": "bun run src/workers/leadQualificationWorker.ts",
    "frontend": "bun --hot src/frontend/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5"
  },
  "dependencies": {
    "bullmq": "^5.78.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.0",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
